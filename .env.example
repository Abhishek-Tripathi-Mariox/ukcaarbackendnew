NODE_ENV=development
PORT=5000
API_VERSION=v1
MONGODB_URI=mongodb://localhost:27017/ukcaar
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
REDIS_URL=redis://localhost:6379
# Set to true on EVERY backend instance to share Socket.IO rooms + ride-
# dispatch state across them (required for live tracking/status/chat and
# instant "request taken" dismissal when running more than one backend, or a
# customer-server / driver-server split). All instances must point REDIS_URL
# at the SAME Redis. Leave unset/false for a single instance.
REDIS_ENABLED=false
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_PHONE_NUMBER=+44xxxx
# ── OTP (client-testing phase, no SMS provider) ──
# While ALLOW_TEST_OTP is not "false", the universal TEST_OTP logs in ANY phone
# number. This is a backdoor for testing — set ALLOW_TEST_OTP=false before
# public launch.
ALLOW_TEST_OTP=true
TEST_OTP=115566
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
# ── S3 uploads (REQUIRED in production) ──
# Bucket is 'ukcar' (one 'a') in ap-south-1. The bucket has ACLs disabled
# (Object Ownership: bucket owner enforced) — do NOT send x-amz-acl headers;
# public read is granted by the bucket policy.
S3_BUCKET_NAME=ukcar
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_REGION=ap-south-1
S3_BASE_URL=https://ukcar.s3.ap-south-1.amazonaws.com
